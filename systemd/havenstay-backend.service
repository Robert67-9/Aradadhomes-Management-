[Unit]
Description=HavenStay Luxury Residences - Python FastAPI Backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/havenstay/backend
Environment="PATH=/var/www/havenstay/backend/venv/bin"
Environment="PORT=8000"
Environment="HOST=127.0.0.1"
ExecStart=/var/www/havenstay/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
